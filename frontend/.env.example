# Web3Forms access key — get yours at https://web3forms.com (free, no signup needed beyond email)
# Used by the Contact form. Without this, the form will display an error message.
VITE_WEB3FORMS_KEY=your-access-key-here

# URL of the AstroVexus backend API (see /backend). Local default: http://localhost:4000
VITE_API_URL=http://localhost:4000
