# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGIN=http://localhost:5173,https://astrovexus.vercel.app

# Resend (https://resend.com): sends the autoresponder and stores subscribers.
# Leave RESEND_API_KEY empty in development to run in dry-run mode (logs only).
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Must be on a domain you verified in Resend. For testing only: AstroVexus <onboarding@resend.dev>
MAIL_FROM=AstroVexus <hello@yourdomain.com>
# Where replies to the autoresponder go
MAIL_REPLY_TO=daudki044@gmail.com
