# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGIN=http://localhost:5173,https://astrovexus.vercel.app

# Database (PostgreSQL). Local: `docker compose up -d` in /backend uses this exact URL.
DATABASE_URL=postgres://astro:astro@localhost:5432/astrovexus
# SSL defaults to on in production and off elsewhere. Override with true or false if needed.
DATABASE_SSL=

# Login tokens. Required in production: a random string of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Image uploads (Cloudinary, https://cloudinary.com). Leave empty to turn image uploads off.
# Find all three on the Cloudinary dashboard under Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=astrovexus/insights

# Creates the FIRST admin, only while there are no users. Sign in, then remove ADMIN_PASSWORD.
ADMIN_EMAIL=astrovexus@gmail.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=

# Resend (https://resend.com): sends the autoresponder and stores subscribers as Contacts.
# Leave RESEND_API_KEY empty in development to run in dry-run mode (logs only).
RESEND_API_KEY=
# Optional: add new subscribers to a Segment (copy its ID from the Segments page). Leave empty to skip.
RESEND_SEGMENT_ID=
# Must be on a domain you verified in Resend. For testing only: AstroVexus <onboarding@resend.dev>
MAIL_FROM=AstroVexus <hello@yourdomain.com>
# Where replies to the autoresponder go
MAIL_REPLY_TO=astrovexus@gmail.com
